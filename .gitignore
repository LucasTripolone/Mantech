# reales de WiFi y del dispositivo no debe salir de la máquina de quien arma.
firmware/mantech-sensor/config.local.h
.env
.env.*
!.env.example
*.local

# ---- Entorno de desarrollo ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ---- Registros y temporales ----
*.log
npm-debug.log*
yarn-error.log*
tmp/
