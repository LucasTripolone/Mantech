# ---- Backend (Maven / Spring Boot) ----
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
!backend/.mvn/wrapper/*.properties

# Archivos que sube el operario desde la app (fotos y audios de los reportes).
backend/uploads/
uploads/

# ---- Frontend (Expo / React Native) ----
frontend/app-mantech/node_modules/
frontend/app-mantech/dist/
frontend/app-mantech/.expo/
frontend/app-mantech/web-build/
frontend/app-mantech/.expo-shared/
node_modules/

# ---- Secretos y configuración local ----
